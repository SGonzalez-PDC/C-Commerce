        "query": "SELECT ISNULL(MAX(TRY_CONVERT(int, ctx.[value])), 0) + 1 AS ticket\nFROM DEV_C_COMMERCE.dbo.c_comerce_tbl_txn_conversation_context ctx\nWHERE ctx.[key] = 'customer_code'\n  AND ctx.company = '00010';"
