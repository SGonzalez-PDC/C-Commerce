        "jsCode": "const cart = $('Obtener Carrito').first().json;\nconst r = $('Agregar Item').first().json;\nif (!r || r.status >= 400) return [{ json: { ok: false, error: r?.message || 'Error al agregar' } }];\nreturn [{ json: { ok: true, cart_id: cart?.data?.cart_id || null, line_id: r?.data?.line_id || null } }];"
      },
