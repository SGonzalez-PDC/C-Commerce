      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nif (!response || response.status >= 400) {\n  return [{ json: { ok: false, error: response?.message || 'Error al iniciar el carrito' } }];\n}\n\nconst cart_id = response?.data?.cart_id || null;\n\nif (!cart_id) {\n  return [{ json: { ok: false, error: 'No se recibio cart_id en la respuesta' } }];\n}\n\nreturn [{ json: { ok: true, cart_id } }];"
